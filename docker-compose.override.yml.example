# Copy to docker-compose.override.yml for local development conveniences.
# The override is git-ignored; never put production values here.
services:
  backend:
    build:
      target: dev
    environment:
      NODE_ENV: development
      LOG_LEVEL: debug
    volumes:
      - ./backend/src:/app/src:ro
    ports:
      - "8080:8080"   # bypass nginx for direct API access in dev

  frontend:
    build:
      target: dev
    volumes:
      - ./frontend/src:/app/src:ro
    ports:
      - "5173:5173"   # Vite dev server with HMR

  opensearch:
    environment:
      OPENSEARCH_JAVA_OPTS: "-Xms512m -Xmx512m"   # smaller heap for laptops
