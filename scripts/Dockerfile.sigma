# sigma-compiler: one-shot container that validates /rules and writes the
# compiled Wazuh ruleset into the shared volume consumed by wazuh-manager.
FROM node:22-alpine
WORKDIR /compiler
RUN npm install --no-save tsx@4 yaml@2 ajv@8 ajv-formats@3
COPY convert-sigma.ts .
USER 1001:1001
CMD ["npx", "tsx", "convert-sigma.ts"]
